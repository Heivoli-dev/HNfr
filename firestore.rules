rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verifiedEmail() {
      return signedIn() && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', '') is string
        && request.auth.token.get('email', '') != '';
    }
    function isFounder() {
      return verifiedEmail() && request.auth.token.email == 'heivolipro@gmail.com';
    }
    function isAdmin() {
      return signedIn() && (isFounder()
        || (verifiedEmail() && exists(/databases/$(database)/documents/admins/$(request.auth.token.email))));
    }
    function text(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }
    function acceptableComment(value) {
      return !value.lower().matches('[\\s\\S]*(https?://|www[.]|discord[.]gg/|discord(app)?[.]com/invite/)[\\s\\S]*')
        && !value.lower().matches('[\\s\\S]*(^|[^a-zà-ÿ0-9])(connards?|connasses?|encul[eé]s?|salope?s?|pute?s?|fdp|ntm|n[i1]gg(er|a)s?)([^a-zà-ÿ0-9]|$)[\\s\\S]*');
    }
    function commentCooldown(uid, value) {
      let path = /databases/$(database)/documents/commentThrottle/$(uid);
      return !exists(path) || (request.time >= get(path).data.createdAt + duration.value(30, 's')
        && get(path).data.lastText != value.lower());
    }
    function ownsTicket(ticketId) {
      return signedIn() && get(/databases/$(database)/documents/tickets/$(ticketId)).data.creatorId == request.auth.uid;
    }
    function ticketIsOpen(ticketId) {
      return get(/databases/$(database)/documents/tickets/$(ticketId)).data.status == 'open';
    }
    function validAnnouncement() {
      let d = request.resource.data;
      return d.keys().hasAll(['type', 'title', 'text', 'date', 'featured', 'createdAt'])
        && d.keys().hasOnly(['type', 'title', 'text', 'date', 'featured', 'createdAt'])
        && d.type in ['Bienvenue', 'Événement', 'Communauté', 'Important']
        && text(d.title, 1, 80) && text(d.text, 1, 320) && text(d.date, 1, 32)
        && d.featured is bool;
    }
    match /announcements/{announcement} {
      allow read: if true;
      allow create: if isFounder() && validAnnouncement() && request.resource.data.createdAt == request.time;
      allow update: if isFounder() && validAnnouncement() && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isFounder();
      match /comments/{commentId} {
        allow read: if exists(/databases/$(database)/documents/announcements/$(announcement));
        allow create: if signedIn()
          && exists(/databases/$(database)/documents/announcements/$(announcement))
          && request.resource.data.keys().hasAll(['authorId', 'authorName', 'text', 'createdAt'])
          && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'authorPhotoURL', 'text', 'createdAt'])
          && request.resource.data.get('authorPhotoURL', '') is string
          && request.resource.data.get('authorPhotoURL', '').size() <= 2048
          && (!('authorPhotoURL' in request.resource.data) || request.resource.data.authorPhotoURL == request.auth.token.get('discordAvatar', request.auth.token.get('picture', '')))
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName == request.auth.token.get('discordName', request.auth.token.get('name', 'Membre'))
          && text(request.resource.data.authorName, 1, 120)
          && text(request.resource.data.text, 1, 800)
          && request.resource.data.text.matches('[\\s\\S]*[^\\s][\\s\\S]*')
          && acceptableComment(request.resource.data.text)
          && commentCooldown(request.auth.uid, request.resource.data.text)
          && getAfter(/databases/$(database)/documents/commentThrottle/$(request.auth.uid)).data.commentId == commentId
          && getAfter(/databases/$(database)/documents/commentThrottle/$(request.auth.uid)).data.announcementId == announcement
          && getAfter(/databases/$(database)/documents/commentThrottle/$(request.auth.uid)).data.createdAt == request.time
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
      }
    }
    match /commentThrottle/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, delete: if false;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['createdAt', 'lastText', 'commentId', 'announcementId'])
        && request.resource.data.keys().hasOnly(['createdAt', 'lastText', 'commentId', 'announcementId'])
        && text(request.resource.data.lastText, 1, 800)
        && text(request.resource.data.commentId, 1, 1500)
        && text(request.resource.data.announcementId, 1, 1500)
        && request.resource.data.createdAt == request.time
        && commentCooldown(uid, request.resource.data.lastText)
        && getAfter(/databases/$(database)/documents/announcements/$(request.resource.data.announcementId)/comments/$(request.resource.data.commentId)).data.authorId == uid
        && getAfter(/databases/$(database)/documents/announcements/$(request.resource.data.announcementId)/comments/$(request.resource.data.commentId)).data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/announcements/$(request.resource.data.announcementId)/comments/$(request.resource.data.commentId)).data.text.lower() == request.resource.data.lastText;
    }
    match /admins/{id} {
      allow get: if signedIn() && (isFounder()
        || (verifiedEmail() && request.auth.token.email == id));
      allow list: if isFounder();
      allow create, update: if isFounder()
        && request.resource.data.keys().hasAll(['email', 'createdAt'])
        && request.resource.data.keys().hasOnly(['email', 'createdAt'])
        && text(request.resource.data.email, 3, 254)
        && request.resource.data.email == id
        && request.resource.data.createdAt == request.time;
      allow delete: if isFounder();
    }
    match /tickets/{ticketId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['creatorId', 'creatorName', 'creatorEmail', 'subject', 'category', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['creatorId', 'creatorName', 'creatorEmail', 'subject', 'category', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.creatorId == request.auth.uid
        && text(request.resource.data.creatorName, 1, 120)
        && request.resource.data.creatorEmail == request.auth.token.get('email', '')
        && text(request.resource.data.subject, 1, 80)
        && request.resource.data.category in ['Question', 'Signalement', 'Partenariat', 'Autre']
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow get, list: if isAdmin() || (signedIn() && resource.data.creatorId == request.auth.uid);
      allow update: if request.resource.data.updatedAt == request.time
        && ((isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['open', 'closed'])
        || (signedIn() && resource.data.creatorId == request.auth.uid && resource.data.status == 'open'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt'])));
      allow delete: if isAdmin();
      match /messages/{messageId} {
        allow get, list: if isAdmin() || ownsTicket(ticketId);
        allow create: if signedIn() && (isAdmin() || ownsTicket(ticketId)) && ticketIsOpen(ticketId)
          && request.resource.data.keys().hasAll(['authorId', 'authorName', 'authorIsModerator', 'text', 'createdAt'])
          && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'authorIsModerator', 'text', 'createdAt'])
          && request.resource.data.authorId == request.auth.uid
          && text(request.resource.data.authorName, 1, 120)
          && request.resource.data.authorIsModerator == isAdmin()
          && text(request.resource.data.text, 1, 800)
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isAdmin();
      }
    }
  }
}
